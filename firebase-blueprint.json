{
  "entities": {
    "GalleryItem": {
      "title": "Gallery Item",
      "description": "A tattoo work featured in the gallery",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "category": { "type": "string" },
        "artist": { "type": "string" },
        "src": { "type": "string" },
        "likesCount": { "type": "number", "description": "Number of heart reactions" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "category", "artist", "src"]
    },
    "Booking": {
      "title": "Booking Inquiry",
      "description": "A customer booking request",
      "type": "object",
      "properties": {
        "fullName": { "type": "string" },
        "email": { "type": "string" },
        "artist": { "type": "string" },
        "style": { "type": "string" },
        "vision": { "type": "string" },
        "preferredDate": { "type": "string" },
        "preferredTime": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["pending", "confirmed", "completed", "cancelled"] }
      },
      "required": ["fullName", "email", "artist", "style", "vision", "createdAt", "status"]
    }
  },
  "firestore": {
    "gallery_items": {
      "schema": "GalleryItem",
      "description": "Collection of tattoo works"
    },
    "bookings": {
      "schema": "Booking",
      "description": "Collection of customer booking inquiries"
    }
  }
}
