rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // HELPER FUNCTIONS
    function isSignedIn() { return request.auth != null; }
    function isEmailVerified() { return isSignedIn() && request.auth.token.email_verified == true; }
    function isAdmin() { 
      return isEmailVerified() && request.auth.token.email == 'jaesthetic.info@gmail.com';
    }
    
    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }
    
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // 1. GALLERY ITEMS
    match /gallery_items/{itemId} {
      function isValidGalleryItem(data) {
        return data.keys().hasAll(['title', 'category', 'artist', 'src', 'likesCount', 'createdAt'])
          && data.keys().size() == 6
          && data.title is string && data.title.size() <= 100
          && data.category is string && data.category in ['Polynesian', 'Conceptual', 'Minimalist']
          && data.artist is string && data.artist.size() <= 100
          && data.src is string && data.src.size() <= 500
          && data.likesCount is number && data.likesCount >= 0
          && data.createdAt is timestamp;
      }

      allow get, list: if true;
      
      allow create: if isAdmin() && isValidGalleryItem(incoming()) && incoming().createdAt == request.time;
      allow delete: if isAdmin();
      
      allow update: if (
        // Action: Like (Public)
        (incoming().diff(existing()).affectedKeys().hasOnly(['likesCount'])
         && incoming().likesCount == existing().likesCount + 1)
        || (isAdmin() && isValidGalleryItem(incoming()))
      );
    }

    // 2. BOOKINGS
    match /bookings/{bookingId} {
      function isValidBooking(data) {
        return data.keys().hasAll(['fullName', 'email', 'artist', 'style', 'vision', 'createdAt', 'status'])
          && data.keys().size() >= 7
          && data.fullName is string && data.fullName.size() <= 100
          && data.email is string && data.email.size() <= 100 && data.email.matches('^.+@.+$')
          && data.artist is string
          && data.style is string
          && data.vision is string && data.vision.size() <= 2000
          && data.createdAt == request.time
          && (data.status == 'pending');
      }

      allow list: if isAdmin();
      allow get: if isAdmin();
      
      allow create: if isValidBooking(incoming()) && isValidId(bookingId);
      
      allow update: if isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['status']) && incoming().status in ['confirmed', 'completed', 'cancelled'];
    }

    // 3. CONSULTATIONS
    match /consultations/{consultationId} {
      function isValidConsultation(data) {
        return data.keys().hasAll(['clientName', 'clientEmail', 'artistId', 'visionDescription', 'createdAt', 'status'])
          && data.clientName is string && data.clientName.size() <= 100
          && data.clientEmail is string && data.clientEmail.size() <= 100
          && data.artistId is string
          && data.visionDescription is string && data.visionDescription.size() <= 3000
          && data.createdAt == request.time
          && data.status == 'new';
      }

      allow list, get: if isAdmin();
      allow create: if isValidConsultation(incoming()) && isValidId(consultationId);
      allow update: if isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['status']) && incoming().status in ['reviewed', 'scheduled', 'archived'];
    }
  }
}
