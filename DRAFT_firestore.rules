rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // HELPER FUNCTIONS
    function isSignedIn() { return request.auth != null; }
    function isEmailVerified() { return isSignedIn() && request.auth.token.email_verified == true; }
    function isAdmin() { 
      return isEmailVerified() && request.auth.token.email == 'johnharry.alfaro@gmail.com';
    }
    
    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }
    
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // 1. GALLERY ITEMS
    match /gallery_items/{itemId} {
      function isValidGalleryItem(data) {
        return data.keys().hasAll(['title', 'category', 'artist', 'src', 'likesCount', 'createdAt'])
          && data.keys().size() == 6
          && data.title is string && data.title.size() <= 100
          && data.category is string && data.category in ['Polynesian', 'Conceptual', 'Minimalist']
          && data.artist is string && data.artist.size() <= 100
          && data.src is string && data.src.size() <= 500
          && data.likesCount is number && data.likesCount >= 0
          && data.createdAt is timestamp;
      }

      // Public can see works
      allow get, list: if true;
      
      // Admin can manage works
      allow create: if isAdmin() && isValidGalleryItem(incoming()) && incoming().createdAt == request.time;
      allow delete: if isAdmin();
      
      // Public can increment likes
      allow update: if (
        (isSignedIn() || true) // Allow public for now, but better with auth
        && (
          // Action: Like
          (incoming().diff(existing()).affectedKeys().hasOnly(['likesCount'])
           && incoming().likesCount == existing().likesCount + 1)
          || (isAdmin() && isValidGalleryItem(incoming()))
        )
      );
    }

    // 2. BOOKINGS
    match /bookings/{bookingId} {
      function isValidBooking(data) {
        return data.keys().hasAll(['fullName', 'email', 'artist', 'style', 'vision', 'createdAt', 'status'])
          && data.keys().size() >= 7
          && data.fullName is string && data.fullName.size() <= 100
          && data.email is string && data.email.size() <= 100 && data.email.matches('^.+@.+$')
          && data.artist is string
          && data.style is string
          && data.vision is string && data.vision.size() <= 2000
          && data.createdAt == request.time
          && data.status == 'pending';
      }

      // Only admin can see all bookings
      allow list: if isAdmin();
      // Users can see their own if we had auth, for now only allow admin to get by ID
      allow get: if isAdmin();
      
      // Public can submit booking
      allow create: if isValidBooking(incoming()) && isValidId(bookingId);
      
      // Only admin can update status
      allow update: if isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['status']) && incoming().status in ['confirmed', 'completed', 'cancelled'];
    }
    
    // 3. ADMIN LIST (for initial verification)
    match /admins/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
    }
  }
}
